#include <iostream>
#include "Image_Class.h"
#include <string>
using namespace std;
int main(){
    string filename;
    cout<<"please, enter your image name to make it gray"<<endl;
    cin>>filename;

    Image image(filename);
    for(int i=0;i<image.width;i++){
        for(int j=0;j<image.height;j++){
            int avr=0;
            for(int k=0;k<3;k++){
                avr+=image(i,j,k);
            }    
                avr=avr/3;
              for(int k=0;k<3;k++){
                    image(i,j,k)=avr;
                  }    
        }
    }     
                
    string filenameout;
    cout<<"please, enter your new image name"<<endl;
    cin>>filenameout;
    image.saveImage(filenameout);
    return 0;
}
