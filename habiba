void Grayscale(){
  for(int i=0;i<image.width;i++){
        for(int j=0;j<image.height;j++){
            int avr=0;
            for(int k=0;k<3;k++){
                avr+=image(i,j,k);
            }    
                avr=avr/3;
              for(int k=0;k<3;k++){
                    image(i,j,k)=avr;
                  }    
        }
    }    
}

